# Frontend (Next.js)

# Where the backend API lives (server-to-server).
API_URL=http://localhost:3001

# Server-only token used by Next.js route handlers to call admin endpoints.
ADMIN_TOKEN=change-me

# Client-provided "gate" for the /admin page.
# This is NOT a strong auth mechanism; it's a dev-only guard.
ADMIN_GATE=change-me
