# Backend (Fastify)

# What origin is allowed to call the API directly from the browser (CORS).
# If you proxy everything through Next.js, this can stay as your web dev URL.
WEB_ORIGIN=http://localhost:3000

# Admin token used by the backend to protect /api/admin/* endpoints.
# This token should never be exposed to browsers.
ADMIN_TOKEN=change-me

# SQLite database path. Must start with file:
DATABASE_URL=file:./storage/devflow.db

# Server port
PORT=3001
