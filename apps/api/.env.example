# Backend (Fastify)

WEB_ORIGIN=http://localhost:3000
ADMIN_TOKEN=change-me
DATABASE_URL=file:./storage/devflow.db
PORT=3001

# Enable the dev-only admin routes (/api/admin/*).
# Keep this false in production unless you add real authentication.
ENABLE_ADMIN=false

# How to trust forwarded client IP headers.
TRUST_PROXY=private